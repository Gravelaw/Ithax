{
  "format_version": "0.1",
  "meta": {
    "name": "Branch benchmark",
    "description": "Spec 2 benchmark branch: exponential arrivals, 30 per hour (mean 2 min); a probability branch with weights a 0.3 and b 0.7 into sinks sink_a and sink_b."
  },
  "domain": "process",
  "components": [
    {
      "id": "arrivals",
      "type": "source",
      "params": {
        "interarrival": {
          "dist": "exponential",
          "mean": "2 min"
        }
      }
    },
    {
      "id": "split",
      "type": "branch",
      "params": {
        "routes": [
          "a",
          "b"
        ],
        "rule": "probability",
        "weights": {
          "a": 0.3,
          "b": 0.7
        }
      }
    },
    {
      "id": "sink_a",
      "type": "sink",
      "params": {}
    },
    {
      "id": "sink_b",
      "type": "sink",
      "params": {}
    }
  ],
  "connections": [
    {
      "from": "arrivals.out",
      "to": "split.in"
    },
    {
      "from": "split.a",
      "to": "sink_a.in"
    },
    {
      "from": "split.b",
      "to": "sink_b.in"
    }
  ],
  "experiments": [
    {
      "id": "benchmark",
      "length": "200 h",
      "warmup": "10 h",
      "replications": 100,
      "seed": 1005
    }
  ],
  "run": {
    "target": "local",
    "fidelity": "standard"
  }
}
