{
  "format_version": "0.1",
  "meta": {
    "name": "Queue with loss benchmark",
    "description": "Spec 2 benchmark queue, loss: exponential arrivals, 30 per hour (mean 2 min), into a queue of capacity 2 (on_full block), then one server with queue_capacity 0 and exponential service, mean 1.5 min. The queue and the server hold at most 3 items, so the line is M/M/1/3 and an arrival finding it full is discarded by the source."
  },
  "domain": "process",
  "components": [
    {
      "id": "arrivals",
      "type": "source",
      "params": {
        "interarrival": {
          "dist": "exponential",
          "mean": "2 min"
        }
      }
    },
    {
      "id": "line",
      "type": "queue",
      "params": {
        "capacity": 2
      }
    },
    {
      "id": "server",
      "type": "server",
      "params": {
        "capacity": 1,
        "service": {
          "dist": "exponential",
          "mean": "1.5 min"
        },
        "queue_capacity": 0
      }
    },
    {
      "id": "exit",
      "type": "sink",
      "params": {}
    }
  ],
  "connections": [
    {
      "from": "arrivals.out",
      "to": "line.in"
    },
    {
      "from": "line.out",
      "to": "server.in"
    },
    {
      "from": "server.out",
      "to": "exit.in"
    }
  ],
  "experiments": [
    {
      "id": "benchmark",
      "length": "200 h",
      "warmup": "10 h",
      "replications": 100,
      "seed": 1006
    }
  ],
  "run": {
    "target": "local",
    "fidelity": "standard"
  }
}
