{
  "format_version": "0.1",
  "meta": {
    "name": "Failure benchmark",
    "description": "Spec 2 benchmark failure: the M/M/1 server (exponential arrivals mean 2 min, service mean 1.5 min) with failure breakdown, time_to_failure exponential mean 100 min and time_to_repair exponential mean 25 min, so availability MTTF/(MTTF + MTTR) = 0.8. The server is heavily loaded: 0.5 arrivals per minute against 0.533 services per minute of available capacity."
  },
  "domain": "process",
  "components": [
    {
      "id": "arrivals",
      "type": "source",
      "params": {
        "interarrival": {
          "dist": "exponential",
          "mean": "2 min"
        }
      }
    },
    {
      "id": "server",
      "type": "server",
      "params": {
        "capacity": 1,
        "service": {
          "dist": "exponential",
          "mean": "1.5 min"
        }
      }
    },
    {
      "id": "breakdown",
      "type": "failure",
      "params": {
        "target": "server",
        "time_to_failure": {
          "dist": "exponential",
          "mean": "100 min"
        },
        "time_to_repair": {
          "dist": "exponential",
          "mean": "25 min"
        }
      }
    },
    {
      "id": "exit",
      "type": "sink",
      "params": {}
    }
  ],
  "connections": [
    {
      "from": "arrivals.out",
      "to": "server.in"
    },
    {
      "from": "server.out",
      "to": "exit.in"
    }
  ],
  "experiments": [
    {
      "id": "benchmark",
      "length": "200 h",
      "warmup": "10 h",
      "replications": 100,
      "seed": 1010
    }
  ],
  "run": {
    "target": "local",
    "fidelity": "standard"
  }
}
