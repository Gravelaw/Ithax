#!/bin/sh
# lcsim-launcher: find or start the engine service and open the interface in the browser,
# or with --print-url print its address, for scripts and machines without a display
# (python -m lcsim.launcher; spec 3 "Service rules", Launcher, and "Packaging").
set -eu
root=$(dirname "$(dirname "$(readlink -f "$0")")")
unset PYTHONHOME PYTHONPATH
export PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1
exec "$root/python/bin/python3" -m lcsim.launcher "$@"
