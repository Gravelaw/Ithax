#!/bin/sh
# lcsim: start the app (spec 3 "Packaging"; AKS-127). The desktop shell when a display is set
# and its system libraries are found, else the launcher, which opens the interface in the
# default browser. Options are passed on (--config-dir, --data-dir, --ui-dir, --idle-minutes).
set -eu
root=$(dirname "$(dirname "$(readlink -f "$0")")")
# The bundled Python sees only its own packages, whatever the user's environment holds; the
# service and its run workers inherit this.
unset PYTHONHOME PYTHONPATH
export PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1
LCSIM_PYTHON="$root/python/bin/python3"
export LCSIM_PYTHON
shell="$root/lib/lcsim-desktop"

if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    reason="no display is set (DISPLAY, WAYLAND_DISPLAY)"
elif [ ! -x "$shell" ]; then
    reason="the desktop shell is missing from $root/lib"
elif command -v ldd >/dev/null 2>&1 && missing=$(ldd "$shell" 2>/dev/null | grep "not found"); then
    reason="the desktop shell's system libraries are missing:
$missing
On Ubuntu or Debian: sudo apt install libwebkit2gtk-4.1-0"
else
    exec "$shell" "$@"
fi
echo "lcsim: opening the interface in the browser, since $reason" >&2
exec "$LCSIM_PYTHON" -m ithax.launcher "$@"
