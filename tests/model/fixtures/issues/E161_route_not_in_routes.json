{
  "format_version": "0.1",
  "meta": {
    "name": "Coffee shop"
  },
  "domain": "process",
  "parameters": {
    "tills": {
      "value": 1,
      "type": "integer",
      "min": 1,
      "max": 5
    }
  },
  "components": [
    {
      "id": "arrivals",
      "type": "source",
      "params": {
        "interarrival": {
          "dist": "exponential",
          "mean": "2 min"
        }
      }
    },
    {
      "id": "till",
      "type": "server",
      "params": {
        "capacity": {
          "$param": "tills"
        },
        "service": {
          "dist": "exponential",
          "mean": "1.5 min"
        }
      }
    },
    {
      "id": "split",
      "type": "branch",
      "params": {
        "routes": [
          "a",
          "b"
        ],
        "rule": "shortest_queue"
      }
    },
    {
      "id": "exit",
      "type": "sink",
      "params": {}
    }
  ],
  "connections": [
    {
      "from": "arrivals.out",
      "to": "till.in"
    },
    {
      "from": "till.out",
      "to": "split.in"
    },
    {
      "from": "split.a",
      "to": "exit.in"
    },
    {
      "from": "split.b",
      "to": "exit.in"
    },
    {
      "from": "split.c",
      "to": "exit.in"
    }
  ],
  "experiments": [
    {
      "id": "base",
      "length": "200 h",
      "warmup": "10 h",
      "replications": 30,
      "seed": 12345
    }
  ],
  "run": {
    "target": "local",
    "fidelity": "standard"
  }
}
