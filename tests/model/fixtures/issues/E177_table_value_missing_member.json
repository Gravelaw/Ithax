{
  "format_version": "0.2",
  "meta": {
    "name": "Transport plan"
  },
  "domain": "optimization",
  "sets": {
    "depots": [
      "north",
      "centre",
      "south"
    ],
    "customers": [
      "city",
      "harbour",
      "park",
      "market"
    ]
  },
  "tables": {
    "supply": {
      "over": [
        "depots"
      ],
      "values": {
        "north": 300,
        "centre": 200,
        "south": 250
      }
    },
    "demand": {
      "over": [
        "customers"
      ],
      "values": {
        "city": 180,
        "harbour": 220,
        "park": 150,
        "market": 170
      }
    },
    "cost": {
      "over": [
        "depots",
        "customers"
      ],
      "values": {
        "north": {
          "city": 4,
          "harbour": 6,
          "park": 9,
          "market": 5
        },
        "centre": {
          "city": 7,
          "harbour": 3,
          "park": 5,
          "market": 8
        },
        "south": {
          "city": 6,
          "harbour": 8,
          "park": 4
        }
      }
    }
  },
  "variables": [
    {
      "id": "ship",
      "type": "continuous",
      "lower": 0,
      "over": [
        "depots",
        "customers"
      ]
    }
  ],
  "objective": {
    "sense": "minimize",
    "terms": [
      {
        "variable": "ship",
        "coefficient": {
          "$table": "cost"
        }
      }
    ]
  },
  "constraints": [
    {
      "id": "supply",
      "for": [
        "depots"
      ],
      "terms": [
        {
          "variable": "ship"
        }
      ],
      "op": "<=",
      "rhs": {
        "$table": "supply"
      }
    },
    {
      "id": "demand",
      "for": [
        "customers"
      ],
      "terms": [
        {
          "variable": "ship"
        }
      ],
      "op": ">=",
      "rhs": {
        "$table": "demand"
      }
    }
  ]
}
