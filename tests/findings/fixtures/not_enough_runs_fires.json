      "dist": "exponential",
      "mean": "1.2 min"
     }
    }
   },
   {
    "id": "weld",
    "type": "server",
    "params": {
     "capacity": 1,
     "service": {
      "dist": "exponential",
      "mean": "1.8 min"
     }
    }
   },
   {
    "id": "transfer",
    "type": "delay",
    "params": {
     "time": {
      "dist": "constant",
      "value": "2 min"
     }
    }
   },
   {
    "id": "paint",
    "type": "server",
    "params": {
     "capacity": 1,
     "service": {
      "dist": "exponential",
      "mean": "1 min"
     }
    }
   },
   {
    "id": "exit",
    "type": "sink",
    "params": {}
