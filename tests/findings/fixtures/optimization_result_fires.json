 "about": "benchmarks/machine_count/model.json unchanged: the coffee shop searched over tills 1 to 5 (exhaustive path, budget 10, seed 12345); a search run's summary.json with its search block (spec 2 'Simulation-based optimization').",
 "model": {
  "format_version": "0.1",
  "meta": {
   "name": "Machine count",
   "description": "Spec 2 benchmark 'Machine count (simulation-based)': the coffee shop (examples/coffee_shop.json) with tills from 1 to 5, objective minimize till.wait.mean, constraint till.utilization >= 0.35, search budget 10 (the exhaustive path, since the five combinations fit) and the file's seed. Erlang C: 1 till waits 4.500 min at utilization 0.75; 2 tills 0.245 min at 0.375; 3 or more are below 0.35, so the best is 2."
  },
  "domain": "process",
  "parameters": {
   "tills": {
    "value": 1,
    "type": "integer",
    "min": 1,
    "max": 5
   }
  },
  "components": [
   {
    "id": "arrivals",
    "type": "source",
    "params": {
     "interarrival": {
      "dist": "exponential",
      "mean": "2 min"
     }
    }
   },
   {
    "id": "till",
    "type": "server",
    "params": {
     "capacity": {
      "$param": "tills"
     },
     "service": {
      "dist": "exponential",
      "mean": "1.5 min"
     }
    }
   },
   {
    "id": "exit",
    "type": "sink",
    "params": {}
   }
  ],
  "connections": [
   {
    "from": "arrivals.out",
    "to": "till.in"
   },
   {
    "from": "till.out",
    "to": "exit.in"
   }
  ],
  "objectives": [
   {
    "id": "wait",
    "metric": "till.wait.mean",
    "sense": "minimize"
   }
  ],
  "constraints": [
   {
    "id": "busy",
    "metric": "till.utilization",
    "op": ">=",
    "value": 0.35
   }
  ],
  "experiments": [
   {
    "id": "base",
    "length": "200 h",
    "warmup": "10 h",
    "replications": 30,
    "seed": 12345,
    "search": {
     "objective": "wait",
     "budget": 10
    }
   }
  ],
  "run": {
   "target": "local",
   "fidelity": "standard"
  }
 },
