{
  "format_version": "0.1",
  "meta": {
    "name": "How many machines?",
    "description": "The coffee shop (examples/coffee_shop.json) asking how many tills to open: customers every 2 minutes, 1.5 minutes at a till, both at random. The experiment searches the parameter tills from 1 to 5 for the shortest mean wait, while each till stays busy at least 35% of the time. The run is 200 h including 10 h of warm-up, so 190 h are measured, for each candidate. Erlang C gives the answer the search finds: 2 tills, a wait of 14.7 s at 37.5% busy (benchmarks/machine_count)."
  },
  "domain": "process",
  "parameters": {
    "tills": {
      "value": 1,
      "type": "integer",
      "min": 1,
      "max": 5
    }
  },
  "components": [
    {
      "id": "arrivals",
      "type": "source",
      "params": {
        "interarrival": {
          "dist": "exponential",
          "mean": "2 min"
        }
      }
    },
    {
      "id": "till",
      "type": "server",
      "params": {
        "capacity": {
          "$param": "tills"
        },
        "service": {
          "dist": "exponential",
          "mean": "1.5 min"
        }
      }
    },
    {
      "id": "exit",
      "type": "sink",
      "params": {}
    }
  ],
  "connections": [
    {
      "from": "arrivals.out",
      "to": "till.in"
    },
    {
      "from": "till.out",
      "to": "exit.in"
    }
  ],
  "objectives": [
    {
      "id": "wait",
      "metric": "till.wait.mean",
      "sense": "minimize"
    }
  ],
  "constraints": [
    {
      "id": "busy",
      "metric": "till.utilization",
      "op": ">=",
      "value": 0.35
    }
  ],
  "experiments": [
    {
      "id": "base",
      "length": "200 h",
      "warmup": "10 h",
      "replications": 30,
      "seed": 12345,
      "search": {
        "objective": "wait",
        "budget": 10
      }
    }
  ],
  "run": {
    "target": "local",
    "fidelity": "standard"
  }
}
