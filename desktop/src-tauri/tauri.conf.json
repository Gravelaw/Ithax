{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lcsim",
  "version": "0.0.0",
  "identifier": "org.lcsim.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; connect-src 'none'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
