// Spec 5 trial: build MSD.mo into FMI 2.0 Co-Simulation FMUs with OpenModelica.
// Run as `omc build.mos` in a folder holding MSD.mo; prints each step's errors.
getVersion();
installPackage(Modelica, "4.1.0+maint.om", exactMatch = false); getErrorString();
loadModel(Modelica, {"4.1.0"}); getErrorString();
getVersion(Modelica);
loadFile("MSD.mo"); getErrorString();
checkModel(MSD); getErrorString();
// Dynamically linked to the installed runtime libraries, set explicitly: the API's default
// is platforms = {"static"} (OpenModelica scripting API, buildModelFMU).
buildModelFMU(MSD, version = "2.0", fmuType = "cs", fileNamePrefix = "MSD_dynamic", platforms = {"dynamic"}); getErrorString();
// Statically linked (the default), to test whether it runs where OpenModelica is not installed.
buildModelFMU(MSD, version = "2.0", fmuType = "cs", fileNamePrefix = "MSD_static", platforms = {"static"}); getErrorString();
// The user's guide documents the Co-Simulation integrator as a flag; CI run 43935773704
// showed the default FMUs behaving like forward Euler at the communication step, so this
// build asks for CVODE explicitly.
setCommandLineOptions("--fmiFlags=s:cvode"); getErrorString();
buildModelFMU(MSD, version = "2.0", fmuType = "cs", fileNamePrefix = "MSD_cvode", platforms = {"static"}); getErrorString();
