{UTF-8}
Susceptible= INTEG (-infection rate, Population - Initial infected)
	~	person
	~		|

Infected= INTEG (infection rate - recovery rate, Initial infected)
	~	person
	~		|

Recovered= INTEG (recovery rate, 0)
	~	person
	~		|

infection rate= beta * Susceptible * Infected / Population
	~	person/Day
	~		|

recovery rate= gamma * Infected
	~	person/Day
	~		|

Population= 1000
	~	person
	~		|

Initial infected= 1
	~	person
	~		|

beta= 0.5
	~	1/Day
	~		|

gamma= 0.25
	~	1/Day
	~		|

