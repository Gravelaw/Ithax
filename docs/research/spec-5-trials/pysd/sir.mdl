	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	Day
	~		|

INITIAL TIME  = 0
	~	Day
	~		|

SAVEPER  = TIME STEP
	~	Day
	~		|

TIME STEP  = 0.0625
	~	Day
	~		|

